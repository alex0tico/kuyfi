# kuyfi-server: paid OSINT scan endpoint (GET /scan/:contractId).
# Copy to .env and run: node --env-file=.env dist/server.js

# Public Stellar address (G...) that receives the USDC. Never put a secret key here.
PAY_TO=

# Price in local currency, converted to USDC per request through the Reflector oracle.
PRICE=500 CLP

# Network the payment settles on: stellar:testnet or stellar:pubnet.
# Scans always read Soroban Testnet, whatever this is.
NETWORK=stellar:testnet

# Defaults to the public Local402 facilitator for NETWORK. The mainnet one only
# settles for allowlisted PAY_TO addresses.
# FACILITATOR_URL=https://local402.vercel.app/facilitator

PORT=4021

# Signs each price quote, so the paid retry is checked against the price that was
# offered. Required, at least 32 characters: openssl rand -hex 32
# Use the same value on every instance if you run more than one.
LOCAL402_QUOTE_SECRET=

# ---------------------------------------------------------------------------
# authz fixtures:  npm run authz:testnet  (Soroban Testnet, from scratch)
# With everything below empty, the command funds fresh accounts via Friendbot,
# deploys the fixtures and runs every matrix. Nothing here is required.
# ---------------------------------------------------------------------------

# Reuse an existing deployment instead: set ALL four ids plus both secrets.
# AUTHZ_VAULT_ID=
# AUTHZ_POLICY_ID=
# AUTHZ_ROUTER_ID=
# AUTHZ_EXECUTOR_ID=
# Testnet-only throwaway keys (S...). Never use a key that holds real funds.
# AUTHZ_ADMIN_SECRET=
# AUTHZ_OWNER_SECRET=

# Optional: label for the run, evidence directory, skip the broadcast matrices.
# AUTHZ_RUN_ID=
# AUTHZ_OUT_DIR=
# AUTHZ_SKIP_ONCHAIN=1
