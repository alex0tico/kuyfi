# kuyfi-server: paid OSINT scan endpoint (GET /scan/:contractId).
# Copy to .env and run: node --env-file=.env dist/server.js

# Public Stellar address (G...) that receives the USDC. Never put a secret key here.
PAY_TO=

# Price in local currency, converted to USDC per request through the Reflector oracle.
PRICE=500 CLP

# Network the payment settles on: stellar:testnet or stellar:pubnet.
# Scans always read Soroban Testnet, whatever this is.
NETWORK=stellar:testnet

# Defaults to the public Local402 facilitator for NETWORK. The mainnet one only
# settles for allowlisted PAY_TO addresses.
# FACILITATOR_URL=https://local402.vercel.app/facilitator

PORT=4021

# Only when running more than one instance: the same random value on all of them,
# so a quote issued by one instance is honored by another.
# LOCAL402_QUOTE_SECRET=
