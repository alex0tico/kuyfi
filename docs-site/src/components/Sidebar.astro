---
import { NAV } from '../content/nav';
import { withBase } from '../lib/paths';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;

function normalize(path: string) {
	const cleaned = path.replace(/\/$/, '') || '/';
	return cleaned;
}

const current = normalize(currentPath);
---

<aside class="sidebar" id="docs-sidebar">
	<div class="sidebar__scroll">
		{
			NAV.map((group) => (
				<div class="group">
					<p class="group__title">{group.title}</p>
					<ul>
						{group.items.map((item) => {
							const href = withBase(item.href);
							const active = normalize(href) === current;
							return (
								<li>
									<a
										class:list={['link', { 'is-active': active }]}
										href={href}
										aria-current={active ? 'page' : undefined}
									>
										<span>{item.label}</span>
										{item.badge && <span class="badge">{item.badge}</span>}
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			))
		}
	</div>
	<div class="sidebar__foot">
		<a class="llm-link" href={withBase('/agent-setup')}>agents</a>
		<a class="llm-link" href={withBase('/llms.txt')}>llms.txt</a>
		<a class="llm-link" href={withBase('/llms-full.txt')}>full</a>
	</div>
</aside>

<style>
	.sidebar {
		position: fixed;
		top: var(--header-h);
		left: 0;
		bottom: 0;
		width: min(86vw, var(--sidebar-w));
		border-right: 1px solid var(--border);
		background: rgba(7, 7, 8, 0.96);
		transform: translateX(-105%);
		transition: transform 0.2s ease;
		z-index: 30;
		display: flex;
		flex-direction: column;
	}

	.sidebar.is-open {
		transform: translateX(0);
	}

	@media (min-width: 960px) {
		.sidebar {
			position: sticky;
			top: var(--header-h);
			height: calc(100vh - var(--header-h));
			transform: none;
			width: var(--sidebar-w);
			background: transparent;
		}
	}

	.sidebar__scroll {
		overflow-y: auto;
		padding: 1.25rem 1rem 1rem;
		flex: 1;
	}

	.group {
		margin-bottom: 1.35rem;
	}

	.group__title {
		margin: 0 0 0.55rem 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--pink);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.45rem 0.6rem;
		border-radius: var(--radius);
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		border: 1px solid transparent;
	}

	.link:hover {
		color: var(--text);
		background: rgba(255, 255, 255, 0.03);
		text-decoration: none;
	}

	.link.is-active {
		color: var(--yellow);
		background: var(--yellow-soft);
		border-color: rgba(245, 197, 24, 0.25);
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		padding: 0.12rem 0.35rem;
		border-radius: 999px;
		border: 1px solid rgba(245, 197, 24, 0.35);
		color: var(--yellow);
	}

	.sidebar__foot {
		padding: 0.85rem 1rem 1.1rem;
		border-top: 1px solid var(--border);
		display: flex;
		gap: 0.75rem;
	}

	.llm-link {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-dim);
		text-decoration: none;
	}

	.llm-link:hover {
		color: var(--yellow);
	}
</style>
