---
import DocsLayout from '../layouts/DocsLayout.astro';
import Callout from '../components/Callout.astro';
import {SITE} from '../content/nav';
---

<DocsLayout
	title="Changelog"
	eyebrow="[ RELEASES ]"
	description="What shipped in Kuyfi — mirrored from the repo CHANGELOG for docs readers."
>
	<Callout type="tip" title="Canonical file">
		<p>
			Source of truth remains{' '}
			<a href={`${SITE.github}/blob/main/CHANGELOG.md`}>CHANGELOG.md</a> on GitHub. This page
			is the curated docs view for {SITE.version}.
		</p>
	</Callout>

	<h2>Unreleased</h2>
	<ul>
		<li>
			<strong>Added</strong> — <code>kuyfi-server</code>: paid HTTP
			<code>GET /scan/:contractId</code> (x402 / Local402, CLP pricing). Chaos Monkey not
			exposed over HTTP.
		</li>
	</ul>

	<h2>0.1.0 — 2026-09-20</h2>
	<h3>Added</h3>
	<ul>
		<li>Black-box OSINT scanner from deployed WASM</li>
		<li>Chaos Monkey: math, access-control, UDT, call-order, fee, liquidity families</li>
		<li>DiagnosticEvent classification + six-signal taxonomy</li>
		<li>Headless CLI + JSON/PDF SecurityReport (<code>schemaVersion 1.0.0</code>)</li>
		<li>TUI export keys <code>[J]</code>/<code>[P]</code>/<code>[B]</code></li>
		<li>Execution evidence (hashes, ledgers, explorer URLs)</li>
		<li>npm package <code>@kuyfi/kuyfi</code>, responsive TUI, ASCII asset system</li>
	</ul>
	<h3>Changed</h3>
	<ul>
		<li>Package rename from <code>kuyfi_tui</code> → <code>@kuyfi/kuyfi</code></li>
		<li>Modular TUI (<code>screens/</code>, <code>components/</code>, <code>hooks/</code>, <code>ui/</code>)</li>
	</ul>
	<h3>Fixed</h3>
	<ul>
		<li>Terminal shrink-resize stale frames</li>
		<li>Duplicate React keys in Chaos Monkey log list</li>
		<li>Trace edge cases that over-escalated precondition failures</li>
	</ul>

	<h2>0.0.0 — 2026-06-09</h2>
	<ul>
		<li>Phase 1 OSINT Scanner baseline (WASM fetch, contractspec parse, UDT registry)</li>
	</ul>
</DocsLayout>
